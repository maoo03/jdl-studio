exports[`renders default snapshot 1`] = `
<div>
  <div
    class="wrap app"
  >
    <header
      class="dark-theme"
    >
      <div
        class="tools left"
      >
        <a
          class="logo-img"
          href="https://www.jhipster.tech/"
          rel="noopener noreferrer"
          target="_blank"
          title="JHipster website"
        >
          <img
            alt="JHipster logo"
            class="jhi-logo"
            src="data:image/svg+xml;base64,"
          />
        </a>
        <a
          class="logo link"
          title="About JDL-Studio"
        >
          JDL-Studio
        </a>
      </div>
      <div
        class="tools right"
      >
        <div
          class="tools-inner"
        >
          <a
            class="link"
            title="Toggle theme"
          >
            <i
              class="lni lni-sun size-md "
            />
          </a>
          <a
            class="link"
            title="Cycle graph ranker strategy [current: tight-tree]"
          >
            <i
              class="lni lni-grid-alt size-md "
            />
          </a>
          <a
            class="link"
            title="Cycle graph direction [current: down]"
          >
            <i
              class="lni lni-arrow-right size-md "
            />
          </a>
          <span
            class="seperator"
          >
            <i>
              |
            </i>
          </span>
          bound HTMLSelectElement {
            "0": <option
              value=""
            >
              &lt;Select template&gt;
            </option>,
            "1": <option
              value="default sample"
            >
              default sample
            </option>,
            "2": <option
              value="simple monolith"
            >
              simple monolith
            </option>,
            "3": <option
              value="simple microservice"
            >
              simple microservice
            </option>,
          }
        </div>
        <div
          class="tools-inner"
        >
          <a
            class="special"
            href="https://start.jhipster.tech/jdl-studio/"
            id="signin"
            title="Go to stable JDL Studio with more features"
          >
            Go to stable JDL Studio
          </a>
          <span
            class="seperator"
          >
            <i>
              |
            </i>
          </span>
          <a
            class="link"
            download="app-jdl.png"
            id="savebutton"
            title="Download snapshot of this diagram"
          >
            <i
              class="lni lni-camera size-md "
            />
          </a>
          <a
            class="link"
            download="app.jdl"
            id="saveTextbutton"
            title="Download this JDL source"
          >
            <i
              class="lni lni-download size-md "
            />
          </a>
          <a
            class="upload-dialog link"
            id="uploadbutton"
            title="Import text file of a JDL"
          >
            <i
              class="lni lni-upload size-md "
            />
          </a>
          <a
            class="link"
            title="About JDL-Studio"
          >
            <i
              class="lni lni-question-circle size-md "
            />
          </a>
          <a
            class="link"
            title="Language reference"
          >
            <i
              class="lni lni-book size-md "
            />
          </a>
          <span
            class="tooltip"
          />
        </div>
      </div>
    </header>
    <div
      class="studio dark-theme "
    >
      <div
        class="line-numbers error"
      />
      <div
        class="line-marker"
      />
      <div
        class="react-codemirror2 code-mirror-editor"
      >
        <div
          class="CodeMirror cm-s-solarized cm-s-dark"
          translate="no"
        >
          <div
            style="overflow: hidden; position: relative; width: 3px; height: 0px; top: 0px; left: 0px;"
          >
            <textarea
              autocapitalize="off"
              autocorrect="off"
              spellcheck="false"
              style="position: absolute; bottom: -1em; padding: 0px; width: 1000px; height: 1em; min-height: 1em; outline-color: none; outline-style: none; outline-width: initial;"
              tabindex=""
            />
          </div>
          <div
            class="CodeMirror-vscrollbar"
            cm-not-content="true"
